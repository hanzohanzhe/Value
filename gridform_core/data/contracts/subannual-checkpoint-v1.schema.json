{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value:contract:subannual-checkpoint:v1",
  "title": "VALUE subannual checkpoint",
  "description": "Verified solver-neutral runtime checkpoint at a calendar-month boundary.",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "run_id",
    "model_year",
    "calendar_month",
    "boundary_timestamp",
    "last_committed_period",
    "last_committed_period_id",
    "next_period",
    "next_period_id",
    "period_hours",
    "chronology_sha256",
    "chronological_storage_state",
    "agent_observations",
    "writer_offsets",
    "random_generator_states",
    "year_to_date",
    "frozen_input_hashes",
    "frozen_module_hashes",
    "parent_annual_checkpoint_identity",
    "ledger_boundary",
    "publication_state",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "value.subannual-checkpoint/v1"},
    "checkpoint_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "model_year": {"type": "integer"},
    "calendar_month": {"type": "integer", "minimum": 1, "maximum": 12},
    "boundary_timestamp": {"type": "string", "minLength": 1},
    "last_committed_period": {"type": "integer", "minimum": 0},
    "last_committed_period_id": {"type": "string", "minLength": 1},
    "next_period": {"type": "integer", "minimum": 0},
    "next_period_id": {"type": "string", "minLength": 1},
    "period_hours": {"type": "number", "exclusiveMinimum": 0},
    "chronology_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chronological_storage_state": {"type": "array"},
    "agent_observations": {"type": "object"},
    "writer_offsets": {"type": "object"},
    "random_generator_states": {"type": "object"},
    "year_to_date": {"type": "object"},
    "frozen_input_hashes": {"type": "object"},
    "frozen_module_hashes": {"type": "object"},
    "parent_annual_checkpoint_identity": {"type": "object"},
    "ledger_boundary": {"type": "object"},
    "publication_state": {"const": "verified"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
