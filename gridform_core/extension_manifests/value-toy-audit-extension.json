{
  "schema_version": "value.extension-bundle/v1",
  "id": "value-toy-audit-extension",
  "name": "VALUE toy audit extension",
  "version": "1.0.0",
  "licence": "Apache-2.0",
  "namespace": "value.toy-audit",
  "provided_capabilities": ["extension.toy-audit/v1"],
  "required_capabilities": [],
  "composed_module_ids": [],
