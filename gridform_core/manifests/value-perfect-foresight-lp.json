{
  "schema_version": "value.module/v2",
  "id": "value-perfect-foresight-lp",
  "name": "Perfect-foresight co-optimization",
  "version": "1.1.0",
  "scientific_version": "value-perfect-foresight-single-node-lp-v1",
  "slot": "psm",
