{
  "name": "value-network-extensions",
  "version": "0.6.0-alpha.2",
  "license": "Apache-2.0",
  "author": "Hanzhe Xing",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260815.1": true
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1",
    "build": "vinext build",
    "start": "node scripts/serve-value-ui.mjs --host 127.0.0.1",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck:frontend": "tsc --project tsconfig.frontend.json",
    "test:workspace": "node --test tests/run-context.test.mjs tests/workspace-location.test.mjs",
    "test:e2e": "node e2e/run-tests.mjs",
    "test:backend": "py -3.10 -m unittest discover -s tests -p \"test_*.py\" -v",
    "local:api": "py -3.10 -m backend.server",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:install-scripts": "py -3.10 scripts/verify_install_scripts.py",
    "security:audit": "py -3.10 scripts/run_dependency_audit.py --output publication/prompt62-dependency-audit.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@cloudflare/vite-plugin": "1.53.0",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.7",
    "vite": "8.2.1",
    "wrangler": "4.124.0"
  },
  "type": "module"
}
